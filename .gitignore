# 本地 go build 产物（CI 的冒烟二进制也落在这里），不提交
/bin/

# 历史遗留：旧版构建脚本的本地部署参数文件，可能仍留在开发机上，继续忽略以免误提交
/build.env

# Java 编译输出与打进 jar 的 natives（build-natives.sh 产物）
/mod/build/

# 适配层的 Gradle 产物与本地缓存。用 ** 覆盖 modern 的多层工作区
# （modern/<版本>/{common,forge,fabric}/build 比单层深，锚定的 * 匹配不到）
/mod/platform/*/build/
/mod/platform/*/.gradle/
/mod/platform/*/run/
mod/platform/**/build/
mod/platform/**/.gradle/
mod/platform/**/run/

# 遥测接收端只在自有服务器维护，不上传到公开仓库（含其文档）
/cmd/telemetry-ingest/
/deploy/telemetry-ingest.service
/docs/telemetry.md

*.log

.DS_Store
