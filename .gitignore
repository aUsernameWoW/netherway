# 构建产物含有注入的 frps 令牌与房间密钥，绝不能提交
/bin/

# 真实部署参数（frps 地址、可选的密钥），模板见 build.env.example
/build.env

# Java 编译输出；testres 下放着同样内嵌令牌的 agent 二进制
/mod/build/

# 适配层的 Gradle 产物与本地缓存。用 ** 覆盖 modern 的多层工作区
# （modern/<版本>/{common,forge,fabric}/build 比单层深，锚定的 * 匹配不到）
/mod/platform/*/build/
/mod/platform/*/.gradle/
/mod/platform/*/run/
mod/platform/**/build/
mod/platform/**/.gradle/
mod/platform/**/run/

# 遥测接收端只在自有服务器维护，不上传到公开仓库（含其文档）
/cmd/telemetry-ingest/
/deploy/telemetry-ingest.service
/docs/telemetry.md

*.log

.DS_Store
