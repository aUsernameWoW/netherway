# 复制为 build.env 并填入真实值。build.env 已列入 .gitignore，绝不提交——
# 版本库里不出现任何真实地址与密钥（示例一律用文档专用段 203.0.113.x
# 与 example.com），这是仓库可以公开的前提。
#
# 格式：每行 KEY=value，不加引号也不加 export；环境变量可临时覆盖任何一项。

SERVER_ADDR=203.0.113.10
SERVER_PORT=7000
ROOM=gtnh
MOTD=My Server (P2P)

# 预拉取凭证（prefetch/authbridge）用；留空则玩家侧需 -authserver/-bridge
AUTHSERVER=https://skin.example.com/api/yggdrasil
AUTHBRIDGE=

# TOKEN 与 SECRET 建议仍走环境变量（避免长期落盘）；确要写这里也可以：
# TOKEN=
# SECRET=
